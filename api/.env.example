# Backend. Valores privados suministrados solo al servidor.
# Perfil exclusivo de Chat IA: uvicorn api.chat_app:create_app --factory.
# Para login/listado no necesita las claves OpenAI/Anthropic del pipeline.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Elegir según la firma vigente del proyecto. ES256 verifica claves públicas JWKS.
SUPABASE_JWT_ALGORITHM=HS256
# Necesario únicamente para HS256; privado, nunca en frontend.
SUPABASE_JWT_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ENVIRONMENT=dev
# N15 usa el adaptador Gemini existente. Clave separada para el chat.
CHAT_GEMINI_API_KEY=
CHAT_MODEL=gemini-3.5-flash-lite
